# Copy this file to .env and fill in your own values.
# Never commit your real .env file — it's already in .gitignore.

# Which provider to use: "cohere" or "huggingface"
AI_PROVIDER=cohere

# Cohere settings (used when AI_PROVIDER=cohere)
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-a-03-2025

# Hugging Face settings (used when AI_PROVIDER=huggingface)
HF_API_KEY=your_huggingface_api_key_here
HF_MODEL=your_huggingface_model_name_here
